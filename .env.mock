# Isolated sync-testing environment. Points at a dead local port, so the real
# cloud-sync code paths run and can be observed, but can NEVER reach the
# production Supabase project.
#
#   npx vite build --mode mock && npm run preview
#
# Use this (not .env.local) to test push/pull, offline->online reconnect, or
# anything that writes. .env.uitest disables cloud entirely and is the right
# choice for pure UI work; this one is for exercising sync itself.
VITE_SUPABASE_URL=http://localhost:4199
VITE_SUPABASE_ANON_KEY=mock_key_not_a_real_credential
